APP_NAME="GPT Astra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gpt_astra
DB_USERNAME=forge
DB_PASSWORD=
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=info

# Paper-only. These values must remain disabled.
ASTRA_EXECUTION_ENABLED=false
ASTRA_EXCHANGE_MODE=disabled

# Public production-market data; no API key required.
ASTRA_MARKET_DATA_URL=https://api.binance.com
ASTRA_MARKET_DATA_DELAY_SECONDS=5
ASTRA_MAX_CANDLE_AGE_SECONDS=3900

# Optional: Binance Spot Testnet API keys for read-only connectivity diagnostics.
# Add actual values ONLY to Forge's environment editor, never to GitHub.
BINANCE_TESTNET_API_KEY=
BINANCE_TESTNET_API_SECRET=
