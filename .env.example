APP_NAME="GPT Astra"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=gpt_astra
DB_USERNAME=forge
DB_PASSWORD=
SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
LOG_CHANNEL=stack
LOG_LEVEL=info
ASTRA_EXECUTION_ENABLED=false
ASTRA_EXCHANGE_MODE=disabled
# Milestone 1: do not add Binance credentials. Trading integration is not implemented.

# Public market data only; never use exchange credentials for Milestone 2.
ASTRA_MARKET_DATA_URL=https://api.binance.com
ASTRA_MARKET_DATA_DELAY_SECONDS=5
ASTRA_MAX_CANDLE_AGE_SECONDS=3900
